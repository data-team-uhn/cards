<node>
	<name>DefaultValueTest</name>
	<primaryNodeType>cards:Questionnaire</primaryNodeType>
	<property>
		<name>title</name>
		<value>Default Value Test</value>
		<type>String</type>
	</property>
	<property>
		<name>description</name>
		<value>CARDS-2535. Exercises the `defaultValue` pre-fill on a new form for every question type that supports it. Open a new form: each question below should already show the default described in its hint, and saving without changes should store that default.</value>
		<type>String</type>
	</property>
	<property>
		<name>requiredSubjectTypes</name>
		<values>
			<value>/SubjectTypes/Patient</value>
		</values>
		<type>Reference</type>
	</property>

