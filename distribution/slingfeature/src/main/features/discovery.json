
{
    "bundles":[
        {
            "id":"org.apache.sling:org.apache.sling.discovery.api:${sling.discovery.api.version}",
            "start-order":"20"
        },
        {
            "id":"org.apache.sling:org.apache.sling.discovery.base:${sling.discovery.base.version}",
            "start-order":"20"
        },
        {
            "id":"org.apache.sling:org.apache.sling.discovery.commons:${sling.discovery.commons.version}",
            "start-order":"20"
        },
        {
            "id":"org.apache.sling:org.apache.sling.discovery.oak:${sling.discovery.oak.version}",
            "start-order":"20"
        },
        {
            "id":"org.apache.sling:org.apache.sling.discovery.support:${sling.discovery.support.version}",
            "start-order":"20"
        }
    ],
    "configurations":{
        "org.apache.sling.serviceusermapping.impl.ServiceUserMapperImpl.amended~sling.discovery":{
            "user.mapping":[
                "org.apache.sling.discovery.commons=[sling-discovery]",
                "org.apache.sling.discovery.base=[sling-discovery]",
                "org.apache.sling.discovery.oak=[sling-discovery]"
            ]
        }
    },
    "repoinit:TEXT|true": "@file"
}
