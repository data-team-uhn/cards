<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.uhndata.cards</groupId>
    <artifactId>cards-distribution-parent</artifactId>
    <version>0.9.41-SNAPSHOT</version>
  </parent>

  <artifactId>cards-distribution-docker</artifactId>
  <packaging>pom</packaging>
  <name>CARDS docker image</name>
  <description>The ready to use CARDS distribution as a Docker image.</description>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <inherited>false</inherited>
        <executions>
          <execution>
            <id>prepare-docker-context</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>bash</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <commandlineArgs>prepare_context.sh ${project.version}</commandlineArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.fabric8</groupId>
        <artifactId>docker-maven-plugin</artifactId>
        <configuration>
          <images>
            <image>
              <name>cards/cards:%l</name>
              <build>
                <contextDir>${project.basedir}</contextDir>
                <dockerFile>Dockerfile</dockerFile>
                <filter>${*}</filter>
              </build>
            </image>
          </images>
        </configuration>
        <executions>
          <execution>
            <id>build</id>
            <phase>package</phase>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Fills the image's artifact repository with every artifact referenced by any feature
        built by the reactor, making the image fully self-contained. -->
      <id>production</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.sling</groupId>
            <artifactId>slingfeature-maven-plugin</artifactId>
            <configuration>
              <generatedFeatures>${project.build.directory}/generated-features</generatedFeatures>
              <repositories>
                <repository>
                  <repositoryDir>context/artifacts</repositoryDir>
                  <filesInclude>**/*.json</filesInclude>
                </repository>
              </repositories>
            </configuration>
            <executions>
              <execution>
                <id>self-contained-repository</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>repository</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
