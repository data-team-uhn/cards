{
  "configurations":{
    // The entity-level index for Subjects: subjects have no indexable child items of their own, but their documents
    // can be searched with cross-entity joins against the answers in the forms index
    "io.uhndata.cards.entityindex.internal.EntityIndexManager~subjects":{
      "entity.root": "/Subjects",
      "entity.type": "cards:Subject",
      "item.rules": [],
      "container.types": [],
      "entity.properties": [ "identifier", "fullIdentifier", "type" ],
      "subject.field": "@uuid"
    }
  }
}
