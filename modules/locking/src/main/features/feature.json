{
  "bundles":[
    {
      "id":"${project.groupId}:${project.artifactId}:${project.version}",
      "start-order":"15"
    }
  ],
  "configurations":{
    "org.apache.sling.jcr.repoinit.RepositoryInitializer~locking":{
      "service.ranking:Integer":300,
      "scripts": [
        // In certain environments, this script gets executed before the main forms repoinit does, so we must make sure the paths we reference are created.
        "create path (cards:FormsHomepage) /Forms \n create path (cards:SubjectsHomepage) /Subjects",
        // The location where locks are stored
        "create path (rep:Unstructured) /jcr:system/cards:locks",
        // Locking and unlocking subjects and appropriate visits
        "create service user locking \n set ACL for locking \n allow jcr:all on / \n end",
        "create group LockUsers",
        "create group UnlockUsers",
        "set ACL for everyone \n deny rep:write on /Subjects,/Forms restriction(cards:locked) \n deny rep:write on /jcr:system/cards:locks \n allow jcr:read on /jcr:system/cards:locks \n deny rep:write on /Subjects,/Forms restriction(rep:itemNames, cards:lock) \n end"
      ]
    },
    "org.apache.sling.serviceusermapping.impl.ServiceUserMapperImpl.amended~locking":{
      "user.mapping":[
        "io.uhndata.cards.locking:locking=[locking]"
      ]
    }
  }
}
