{
  "bundles":[
    {
      "id":"${project.groupId}:${project.artifactId}:${project.version}",
      "start-order":"25"
    }
  ],
  "configurations":{
    "org.apache.sling.jcr.repoinit.RepositoryInitializer~locking":{
      "service.ranking:Integer":300,
      "scripts": [
        "create path (cards:LockHomepage) /Locks",
        // Locking and unlocking subjects and appropriate visits
        "create service user locking \n set ACL for locking \n allow jcr:all on / \n end",
        // One of these restrictions needs a placeholder value otherwise repoinit falsely believes the restrictions are duplicates
        "set ACL for everyone \n deny rep:write on /Subjects,/Forms restriction(cards:locked, placeholder) \n deny rep:write on /Locks \n allow jcr:read on /Locks \n deny rep:write on /Subjects,/Forms restriction(rep:itemNames, cards:lock) \n end",
        "create group LockUsers \n set ACL for LockUsers \n allow jcr:addChildNodes, rep:addProperties, jcr:nodeTypeManagement on /Locks \n end",
        "create group UnlockUsers \n set ACL for UnlockUsers \n allow jcr:removeChildNodes, jcr:removeNode on /Locks \n end"
      ]
    },
    "org.apache.sling.serviceusermapping.impl.ServiceUserMapperImpl.amended~locking":{
      "user.mapping":[
        "io.uhndata.cards.locking:locking=[locking]"
      ]
    }
  }
}
