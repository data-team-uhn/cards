<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.uhndata.cards</groupId>
    <artifactId>cards-modules</artifactId>
    <version>0.9.41-SNAPSHOT</version>
  </parent>

  <artifactId>cards-parsing</artifactId>
  <packaging>pom</packaging>
  <name>CARDS - Document parsing</name>
  <description>Document-parsing code: the Python pipeline (Docling parse, markdown cleanup,
    TOC/appendix detection, chunking) in src/main/python with its pytest suite in
    src/test/python. The Java side is added here in a later stage.</description>

  <properties>
    <!-- Python interpreter used to run the tests. Override with -Dpython.executable=...
         (e.g. the Docling virtualenv's python) when needed. -->
    <python.executable>python</python.executable>
  </properties>

  <build>
    <plugins>
      <!-- The Python sources carry license headers; exclude only the generated/config bits. -->
      <plugin>
        <groupId>org.apache.rat</groupId>
        <artifactId>apache-rat-plugin</artifactId>
        <configuration>
          <inputExcludes combine.children="append">
            <exclude>**/__pycache__/**</exclude>
            <exclude>pytest.ini</exclude>
          </inputExcludes>
        </configuration>
      </plugin>

      <!-- Run the pytest suite during the test phase, honouring the shared skipTests flag. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>run-parsing-python-tests</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${skipTests}</skip>
              <executable>${python.executable}</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>-m</argument>
                <argument>pytest</argument>
                <argument>src/test/python</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
