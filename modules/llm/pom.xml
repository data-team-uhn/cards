<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.uhndata.cards</groupId>
    <artifactId>cards-modules</artifactId>
    <version>0.9.41-SNAPSHOT</version>
  </parent>

  <artifactId>cards-llm</artifactId>
  <packaging>bundle</packaging>
  <name>CARDS - LLM</name>
  <description>Forwards prompts to an OpenAI-compatible chat completions endpoint using the Spring AI SDK</description>

  <build>
    <plugins>
      <!-- This is an OSGi bundle -->
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <instructions>
            <!--
              Spring AI (and the Spring Framework, Reactor, Micrometer, ... it pulls in) is not
              published as OSGi bundles, so the whole tree is embedded inside this bundle to keep it
              self-contained. Every compile/runtime dependency is embedded; the platform APIs the
              bundle shares with the container (SLF4J, Sling, servlet, jakarta.json, commons-lang3)
              are declared "provided" below so they are imported instead of embedded.

              Note: Spring AI depends on Jackson 2.19, newer than the 2.17 the platform ships, so
              Jackson is embedded here (isolated to this bundle) rather than imported.
            -->
            <Embed-Dependency>*;scope=compile|runtime</Embed-Dependency>
            <Embed-Transitive>true</Embed-Transitive>
            <Embed-Directory>lib</Embed-Directory>
            <!--
              Only the shared platform packages are hard imports; everything the embedded Spring
              stack references but we do not ship (alternate HTTP clients, Kotlin, Netty, GraalVM,
              etc.) is optional so the bundle can still resolve with just the JDK HTTP client.
            -->
            <Import-Package>
              org.slf4j,
              org.slf4j.helpers,
              org.slf4j.spi,
              jakarta.json,
              jakarta.servlet,
              jakarta.servlet.http,
              org.apache.sling.api,
              org.apache.sling.api.servlets,
              org.apache.commons.lang3,
              !com.google.*,
              *;resolution:=optional
            </Import-Package>
            <_dsannotations>*</_dsannotations>
            <_metatypeannotations>*</_metatypeannotations>
          </instructions>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <!--
      Platform APIs supplied by the OSGi container. These are "provided" so the bundle plugin
      imports them instead of embedding them (see the Embed-Dependency instruction above).
    -->
    <dependency>
      <groupId>jakarta.json</groupId>
      <artifactId>jakarta.json-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.sling</groupId>
      <artifactId>org.apache.sling.api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.sling</groupId>
      <artifactId>org.apache.sling.servlets.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.metatype.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- The Spring AI SDK, embedded into this bundle (see maven-bundle-plugin config above). -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-openai</artifactId>
      <version>${spring-ai.version}</version>
    </dependency>

    <!-- Testing -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
