{
  "title": "CARDS - Clinic Permissions Scheme",
  "description": "A permissions module that allows only the users associated with a clinic see patient surveys for that clinic.",
  "bundles":[
    {
      "id":"${project.groupId}:${project.artifactId}:${project.version}",
      "start-order":"25"
    }
  ],
  "configurations":{
    "org.apache.sling.serviceusermapping.impl.ServiceUserMapperImpl.amended~clinic-permission":{
      "user.mapping":[
        "io.uhndata.cards.permission-clinic=[cards-clinic-permission-manager]"
      ]
    }
  },
  "repoinit:TEXT|true": "@file"
}
