        "ocpe_14": { "role": "radio", "name": "Definitely" },
        "ocpe_15": { "role": "radio", "name": "0 - I had a very poor experience" },
        "ocpe_16": { "role": "textbox", "value": "—" }
      }
    },
    {
      "type": "section",
      "sectionId": "section_module2",
      "answers": {
        "ocpe_17": { "role": "radio", "name": "Definitely" },
        "ocpe_18": { "role": "radio", "name": "Definitely" },
        "ocpe_19": { "role": "radio", "name": "Definitely" },
        "ocpe_20": { "role": "radio", "isMatrix": true,
          "answers": [
            { "key": "ocpe_20_1", "label": "Very good" },
            { "key": "ocpe_20_2", "label": "Fair" },
            { "key": "ocpe_20_3", "label": "Poor" }
          ]
        },
        "ocpe_21": { "role": "radio", "name": "Definitely" },
        "ocpe_22": { "role": "radio", "name": "0 – Not at all likely" }
      }
    }
  ]
}
